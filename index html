<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FLAPPY WING — Arcade Edition</title>
  <style>
    :root {
      --bg-dark: #0f172a;
      --bg-card: #1e293b;
      --bg-card-hover: #273549;
      --accent: #facc15;
      --accent-hover: #eab308;
      --green: #22c55e;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
      --shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.4);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header Navigation */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0.85rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 900;
      font-size: 1.25rem;
      letter-spacing: 0.04em;
    }

    .brand-badge {
      background: var(--accent);
      color: #0f172a;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      box-shadow: 0 3px 0 #b45309;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .header-best {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    @media (max-width: 640px) {
      .nav-links {
        display: none;
      }
    }

    /* Main Content Layout */
    main {
      flex: 1;
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 3rem;
      display: flex;
      flex-direction: column;
      gap: 2.25rem;
    }

    /* Hero Arcade Stage */
    .arcade-stage {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 1.5rem;
      align-items: start;
    }

    @media (max-width: 900px) {
      .arcade-stage {
        grid-template-columns: 1fr;
      }
    }

    .cabinet {
      background: linear-gradient(145deg, #1e293b, #0f172a);
      border: 2px solid var(--border);
      border-radius: 20px;
      padding: 1rem;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
      transition: all 0.3s ease;
    }

    /* Theater Mode */
    body.theater-mode {
      overflow: hidden;
    }

    body.theater-mode .cabinet {
      position: fixed;
      inset: 0;
      z-index: 100;
      border-radius: 0;
      border: none;
      justify-content: center;
      background: #050811;
      padding: 0.75rem;
    }

    .cabinet-top-bar {
      width: 100%;
      max-width: 440px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .status-pill {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    .toolbar-btns {
      display: flex;
      gap: 0.45rem;
    }

    .icon-btn {
      background: var(--bg-card);
      color: var(--text-main);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.35rem 0.65rem;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: background 0.15s, border-color 0.15s;
    }

    .icon-btn:hover {
      background: var(--bg-card-hover);
      border-color: #475569;
    }

    .screen-bezel {
      position: relative;
      width: 100%;
      max-width: 440px;
      aspect-ratio: 2 / 3;
      max-height: 74vh;
      border-radius: 14px;
      overflow: hidden;
      border: 3px solid #090d16;
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
      background: #38bdf8;
      user-select: none;
    }

    body.theater-mode .screen-bezel {
      max-height: 82vh;
      width: auto;
      height: 82vh;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
      cursor: pointer;
      touch-action: manipulation;
    }

    /* Subtle CRT Scanline Overlay */
    .scanlines {
      pointer-events: none;
      position: absolute;
      inset: 0;
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%,
        rgba(0, 0, 0, 0.08) 50%
      );
      background-size: 100% 4px;
      z-index: 4;
    }

    /* In-Game Overlays */
    .overlay {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      text-align: center;
      background: rgba(15, 23, 42, 0.35);
      backdrop-filter: blur(2px);
      transition: opacity 0.2s ease;
    }

    .overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .game-title-art {
      font-size: clamp(2rem, 6vw, 2.75rem);
      font-weight: 900;
      color: #fff;
      text-shadow: 0 4px 0 #0f172a, 0 6px 15px rgba(0, 0, 0, 0.4);
      letter-spacing: 0.04em;
      margin-bottom: 0.5rem;
    }

    .game-subtitle {
      background: rgba(15, 23, 42, 0.78);
      color: #f8fafc;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .play-btn {
      background: var(--accent);
      color: #0f172a;
      border: none;
      border-radius: 14px;
      padding: 0.85rem 2.2rem;
      font-size: 1.15rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      cursor: pointer;
      box-shadow: 0 5px 0 #b45309, 0 10px 20px rgba(0, 0, 0, 0.35);
      transition: transform 0.1s, background 0.15s;
    }

    .play-btn:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }

    .play-btn:active {
      transform: translateY(3px);
      box-shadow: 0 2px 0 #b45309;
    }

    /* Game Over Scorecard */
    .scorecard {
      background: #fef3c7;
      color: #451a03;
      border: 4px solid #78350f;
      border-radius: 16px;
      padding: 1.25rem;
      width: 100%;
      max-width: 280px;
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.5);
      margin-bottom: 1.25rem;
    }

    .scorecard-header {
      font-size: 1.45rem;
      font-weight: 900;
      color: #dc2626;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.85rem;
      border-bottom: 2px dashed #d97706;
      padding-bottom: 0.4rem;
    }

    .scorecard-body {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .medal-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .medal-circle {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #fde68a;
      border: 3px solid #b45309;
      display: grid;
      place-items: center;
      font-size: 1.65rem;
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .medal-label {
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      color: #92400e;
    }

    .score-rows {
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .score-item-label {
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      color: #92400e;
    }

    .score-item-val {
      font-size: 1.55rem;
      font-weight: 900;
      line-height: 1.1;
      color: #451a03;
    }

    .new-badge {
      display: inline-block;
      background: #dc2626;
      color: #fff;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      vertical-align: middle;
      margin-right: 0.25rem;
    }

    /* Live HUD Score */
    .live-hud {
      position: absolute;
      top: 1.1rem;
      left: 0;
      right: 0;
      z-index: 6;
      text-align: center;
      pointer-events: none;
    }

    .live-score {
      display: inline-block;
      font-size: 3rem;
      font-weight: 900;
      color: #fff;
      text-shadow: 0 3px 0 #0f172a, 0 5px 12px rgba(0, 0, 0, 0.45);
      transition: transform 0.12s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .live-score.pop {
      transform: scale(1.25);
    }

    /* Control Deck Sidebar */
    .control-deck {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .panel {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.15rem;
    }

    .panel-title {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .skin-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }

    .skin-btn {
      background: var(--bg-dark);
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 0.65rem 0.4rem;
      color: var(--text-main);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.78rem;
      font-weight: 700;
      transition: all 0.15s;
    }

    .skin-btn.active {
      border-color: var(--accent);
      background: rgba(250, 204, 21, 0.1);
    }

    .skin-swatch {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid #0f172a;
    }

    .controls-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      font-size: 0.88rem;
      color: #cbd5e1;
    }

    .controls-list li {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    kbd {
      background: var(--bg-dark);
      border: 1px solid #475569;
      border-bottom-width: 2px;
      border-radius: 6px;
      padding: 0.15rem 0.45rem;
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--accent);
    }

    /* Dashboard / Leaderboard Section */
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    @media (max-width: 700px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }

    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .stat-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .stat-value {
      font-size: 1.85rem;
      font-weight: 900;
      color: var(--text-main);
    }

    .leaderboard-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .lb-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-dark);
      padding: 0.6rem 0.9rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      font-size: 0.9rem;
    }

    .lb-rank {
      font-weight: 900;
      color: var(--accent);
      width: 28px;
    }

    .lb-date {
      color: var(--text-muted);
      font-size: 0.8rem;
    }

    .lb-score {
      font-weight: 800;
      font-size: 1rem;
    }

    .reset-btn {
      background: transparent;
      border: 1px solid #475569;
      color: var(--text-muted);
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      font-size: 0.75rem;
      cursor: pointer;
    }

    .reset-btn:hover {
      color: #f87171;
      border-color: #f87171;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 1.5rem 1.25rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <header>
    <div class="nav-container">
      <a href="#play" class="brand">
        <span class="brand-badge">🐦</span>
        <span>FLAPPY WING</span>
      </a>
      <nav class="nav-links">
        <a href="#play">Play</a>
        <a href="#leaderboard">Leaderboard</a>
        <a href="#guide">How to Play</a>
      </nav>
      <div class="header-best" title="All-Time Personal Best">
        <span>🏆 BEST:</span>
        <span id="headerBestVal">0</span>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Arcade Stage -->
    <section id="play" class="arcade-stage">
      <div class="cabinet">
        <div class="cabinet-top-bar">
          <div class="status-pill">
            <span class="dot"></span>
            <span>60 FPS Arcade Engine</span>
          </div>
          <div class="toolbar-btns">
            <button id="themeBtn" class="icon-btn" type="button" title="Switch Day/Night Sky">🌙 Night</button>
            <button id="muteBtn" class="icon-btn" type="button" title="Toggle Sound">🔊 Sound</button>
            <button id="theaterBtn" class="icon-btn" type="button" title="Expand Screen">⛶ Theater</button>
          </div>
        </div>

        <div class="screen-bezel">
          <div class="scanlines"></div>

          <div id="liveHud" class="live-hud" style="display: none;">
            <div id="liveScore" class="live-score">0</div>
          </div>

          <!-- Start Screen Overlay -->
          <div id="startOverlay" class="overlay">
            <h1 class="game-title-art">FLAPPY WING</h1>
            <p class="game-subtitle">Tap Screen, Click, or Press Space</p>
            <button id="startBtn" class="play-btn" type="button">PLAY NOW</button>
          </div>

          <!-- Game Over Overlay -->
          <div id="gameOverOverlay" class="overlay hidden">
            <div class="scorecard">
              <div class="scorecard-header">Game Over</div>
              <div class="scorecard-body">
                <div class="medal-box">
                  <div id="medalIcon" class="medal-circle">—</div>
                  <span id="medalName" class="medal-label">No Medal</span>
                </div>
                <div class="score-rows">
                  <div>
                    <div class="score-item-label">Score</div>
                    <div id="finalScore" class="score-item-val">0</div>
                  </div>
                  <div>
                    <div class="score-item-label">
                      <span id="newBestTag" class="new-badge" style="display: none;">NEW</span>Best
                    </div>
                    <div id="finalBest" class="score-item-val">0</div>
                  </div>
                </div>
              </div>
            </div>
            <button id="restartBtn" class="play-btn" type="button">PLAY AGAIN</button>
          </div>

          <canvas id="gameCanvas" width="400" height="600"></canvas>
        </div>
      </div>

      <!-- Control Deck Sidebar -->
      <aside class="control-deck" id="guide">
        <div class="panel">
          <div class="panel-title"><span>Bird Skin</span></div>
          <div class="skin-grid">
            <button class="skin-btn active" data-skin="classic" type="button">
              <span class="skin-swatch" style="background: #facc15;"></span>
              <span>Classic</span>
            </button>
            <button class="skin-btn" data-skin="crimson" type="button">
              <span class="skin-swatch" style="background: #ef4444;"></span>
              <span>Crimson</span>
            </button>
            <button class="skin-btn" data-skin="cyber" type="button">
              <span class="skin-swatch" style="background: #38bdf8;"></span>
              <span>Cyber</span>
            </button>
          </div>
        </div>

        <div class="panel">
          <div class="panel-title"><span>Controls</span></div>
          <ul class="controls-list">
            <li><span>Flap Wings</span> <kbd>Tap / Click / Space</kbd></li>
            <li><span>Quick Restart</span> <kbd>Space / Enter</kbd></li>
            <li><span>Full Screen</span> <kbd>Theater Button</kbd></li>
          </ul>
        </div>

        <div class="panel">
          <div class="panel-title"><span>Medal Tiers</span></div>
          <ul class="controls-list">
            <li><span>🥉 Bronze</span> <strong>5+ pts</strong></li>
            <li><span>🥈 Silver</span> <strong>15+ pts</strong></li>
            <li><span>🥇 Gold</span> <strong>30+ pts</strong></li>
            <li><span>💎 Platinum</span> <strong>50+ pts</strong></li>
          </ul>
        </div>
      </aside>
    </section>

    <!-- Local Telemetry & Leaderboard -->
    <section id="leaderboard">
      <div class="dashboard-grid" style="margin-bottom: 1rem;">
        <div class="stat-card">
          <span class="stat-label">All-Time Best</span>
          <span id="statBest" class="stat-value" style="color: var(--accent);">0</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Flights Completed</span>
          <span id="statGames" class="stat-value">0</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Total Pipes Cleared</span>
          <span id="statPipes" class="stat-value" style="color: var(--green);">0</span>
        </div>
      </div>

      <div class="panel">
        <div class="panel-title">
          <span>Top 5 Local Flights</span>
          <button id="resetStatsBtn" class="reset-btn" type="button">Reset Stats</button>
        </div>
        <div id="leaderboardList" class="leaderboard-list"></div>
      </div>
    </section>
  </main>

  <footer>
    FLAPPY WING Arcade • Built with HTML5 Canvas &amp; Web Audio • Progress saved locally in your browser
  </footer>

  <script>
    (() => {
      // Canvas & Context
      const canvas = document.getElementById("gameCanvas");
      const ctx = canvas.getContext("2d");
      const W = canvas.width;
      const H = canvas.height;

      // UI Elements
      const startOverlay = document.getElementById("startOverlay");
      const gameOverOverlay = document.getElementById("gameOverOverlay");
      const liveHud = document.getElementById("liveHud");
      const liveScoreEl = document.getElementById("liveScore");
      const startBtn = document.getElementById("startBtn");
      const restartBtn = document.getElementById("restartBtn");
      const themeBtn = document.getElementById("themeBtn");
      const mute
